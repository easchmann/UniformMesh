+    def test_uniformmesh_sod(self):
+        """UniformMesh-backed Sod must be bitwise-identical to periodic_grid_example."""
+        for tool in ("gfortran", "gcc"):
+            if not shutil.which(tool):
+                self.skipTest(f"{tool} is required")
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            um = build(root / "um", "uniformmesh")
+            var = build(root / "var", "variable-first")
+            for scheme in [2, 3]:
+                baseline = None
+                for blocks in [1, 4]:
+                    with self.subTest(scheme=scheme, blocks=blocks):
+                        out_um = root / f"um-{scheme}-{blocks}.csv"
+                        out_var = root / f"var-{scheme}-{blocks}.csv"
+                        for exe, out in [(um, out_um), (var, out_var)]:
+                            r = subprocess.run([str(exe), "128", str(blocks), "0.05", str(out), str(scheme)],
+                                               capture_output=True, text=True)
+                            self.assertEqual(r.returncode, 0, r.stdout + r.stderr)
+                        def load(path):
+                            with path.open() as stream:
+                                return [[float(v) for v in row.values()]
+                                        for row in csv.DictReader(stream)]
+                        rows = load(out_um)
+                        self.assertEqual(len(rows), 128)
+                        self.assertTrue(all(math.isfinite(v) for row in rows for v in row))
+                        self.assertTrue(all(row[1] > 0 and row[3] > 0 and row[4] > 0 for row in rows))
+                        mass = sum(row[1] for row in rows) / 128
+                        momentum = sum(row[1] * row[2] for row in rows) / 128
+                        energy = sum(row[1] * row[5] for row in rows) / 128
+                        self.assertAlmostEqual(mass, 0.5625, delta=1e-10)
+                        self.assertAlmostEqual(momentum, 0, delta=1e-10)
+                        self.assertAlmostEqual(energy, 1.375, delta=1e-10)
+                        # uniformmesh must reproduce periodic_grid_example bit-for-bit
+                        if baseline is None:
+                            baseline = load(out_var)
+                        ref = load(out_var)
+                        max_difference = max(abs(a - b)
+                                             for ra, rb in zip(rows, ref)
+                                             for a, b in zip(ra, rb))
+                        self.assertLessEqual(max_difference, 0,
+                                             "uniformmesh differs from periodic_grid_example")
+
 if __name__ == "__main__":
