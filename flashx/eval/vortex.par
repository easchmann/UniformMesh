#  Isentropic vortex with Spark on the UniformMesh (UG Grid, 1 MPI rank, periodic)
#  Based on Simulation/SimulationMain/IsentropicVortex/flash.par.
#  The vortex is advected diagonally and is back at the center at t = 10.

#               grid (UG with +nofbs: the global size is set here)
iGridSize       = 256
jGridSize       = 256

#               UniformMesh
um_nblockx      = 4      # must divide iGridSize, blocks need >= NGUARD cells
um_nblocky      = 4
um_dumpInterval = 500    # write the mesh to um_dump_<step>.bin at the start and every 500 steps (0 = off)

#               simulation parameters
basenm          = "isentropic_vortex_"
log_file        = "isentropic_vortex.log"
restart         = .false.

nend            = 100000    # large: the run ends at tmax
tmax            = 10.

cfl             = 0.5
dtmin           = 1.e-8
dtmax           = 1.0    # dt is set by the CFL condition
dtinit          = 1.e-3

#               problem parameters
gamma           = 1.4
rho_ambient     = 1.0
p_ambient       = 1.0
u_ambient       = 1.0
v_ambient       = 1.0

vortex_strength = 5.0
xctr            = 5.0
yctr            = 5.0

xmin            = 0.0
xmax            = 10.0
ymin            = 0.0
ymax            = 10.0

nx_subint       = 1
ny_subint       = 1

geometry        = "cartesian"

xl_boundary_type = "periodic"
xr_boundary_type = "periodic"
yl_boundary_type = "periodic"
yr_boundary_type = "periodic"

smlrho          = 1.e-100
smallp          = 1.e-100
smalle          = 1.e-100
smallt          = 1.e-100

plot_var_1      = "dens"
