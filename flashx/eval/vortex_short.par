#  Isentropic vortex, FIXED dt, only 100 steps: strict roundoff check of NewImpl vs Spark
#  (identical steps; short enough that WENO-Z weight sensitivity cannot grow).
#  Isentropic vortex with Spark on the UniformMesh (UG Grid, 1 MPI rank, periodic)
#  Based on Simulation/SimulationMain/IsentropicVortex/flash.par.
#  The vortex is advected diagonally and is back at the center at t = 10.

#               grid (UG with +nofbs: the global size is set here)
iGridSize       = 256
jGridSize       = 256

#               UniformMesh
um_nblockx      = 4      # must divide iGridSize, blocks need >= NGUARD cells
um_nblocky      = 4
um_dumpInterval = 0

#               simulation parameters
basenm          = "isentropic_vortex_"
log_file        = "isentropic_vortex.log"
restart         = .false.

nend            = 100    # short run: strict roundoff comparison
tmax            = 10.

cfl             = 0.4    # 0.5 gives a grid-scale checkerboard for the diagonal flow (see eval/results_20261008-113150.md)
dtmin           = 5.e-3    # fixed dt, below the CFL limit (~6.7e-3 at cfl 0.5, 256x256)
dtmax           = 5.e-3
dtinit          = 5.e-3

#               problem parameters
gamma           = 1.4
rho_ambient     = 1.0
p_ambient       = 1.0
u_ambient       = 1.0
v_ambient       = 1.0

vortex_strength = 5.0
xctr            = 5.0
yctr            = 5.0

xmin            = 0.0
xmax            = 10.0
ymin            = 0.0
ymax            = 10.0

nx_subint       = 1
ny_subint       = 1

geometry        = "cartesian"

xl_boundary_type = "periodic"
xr_boundary_type = "periodic"
yl_boundary_type = "periodic"
yr_boundary_type = "periodic"

smlrho          = 1.e-100
smallp          = 1.e-100
smalle          = 1.e-100
smallt          = 1.e-100

plot_var_1      = "dens"
